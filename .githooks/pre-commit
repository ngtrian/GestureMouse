#!/bin/sh
# Git pre-commit hook: Auto ensure UTF-8 with BOM for all staged .ahk files

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
SCRIPT_PATH="$REPO_ROOT/tools/Ensure-Utf8Bom.ps1"

if [ -f "$SCRIPT_PATH" ]; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_PATH" -StagedOnly
fi

exit 0
