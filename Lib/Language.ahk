; Hàm tra cứu chuỗi theo key
L(key) {
    global CurrentLang, LangTable
    if (!LangTable || !LangTable.HasKey("vi"))
        InitLanguage()
    if (LangTable[CurrentLang].HasKey(key))
        return LangTable[CurrentLang][key]
    if (LangTable["vi"].HasKey(key))
        return LangTable["vi"][key]
    return key
}

; Đổi ngôn ngữ và cập nhật toàn bộ Menu, ToolTip và Giao diện Cài đặt
SetLanguage(newLang) {
    global CurrentLang, hSettingsGui
    if (newLang != "vi" && newLang != "en")
        return
    CurrentLang := newLang
    RegWrite, REG_SZ, HKEY_CURRENT_USER\Software\TRIAN\GestureMouse, Language, %CurrentLang%
    fnRebuild := "RebuildTrayMenu"
    if (IsFunc(fnRebuild))
        %fnRebuild%()
    fnTip := "UpdateTrayTip"
    if (IsFunc(fnTip))
        %fnTip%()

    ; Đồng bộ giao diện Cài đặt theo ngôn ngữ mới
    if (hSettingsGui) {
        DetectHiddenWindows, On
        isVis := WinExist("ahk_id " . hSettingsGui) && DllCall("IsWindowVisible", "Ptr", hSettingsGui)
        Gui, Settings:Destroy
        hSettingsGui := 0
        DetectHiddenWindows, Off
        if (isVis)
            Gosub, Settings
    }
}
